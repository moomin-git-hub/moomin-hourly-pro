# Kompyuterda sinash uchun: bu faylni ".env" deb nusxalang va  node --env-file=.env server.js  bilan ishga tushiring.
# Render'da bu fayl kerak emas — qiymatlar Render → Environment bo'limiga yoziladi.

# Baza manzili (majburiy). Neon → Connect oynasidan to'liq nusxalang:
# DATABASE_URL=postgresql://neondb_owner:PAROL@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Kompyuterdagi PostgreSQL uchun:
DATABASE_URL=postgres://foydalanuvchi:parol@localhost:5432/vaqtbanki

# Port (Render o'zi beradi; kompyuterda 3000)
PORT=3000

# 0 qilinsa, yangi ro'yxatdan o'tish yopiladi (mavjud hisoblar kira oladi)
ALLOW_SIGNUP=1

# index.html boshqa manzilda tursa (GitHub Pages va h.k.), ruxsat berilgan manzillar. Standart: * (hammasi)
# CORS_ORIGIN=https://moomin-git-hub.github.io

# Baza ulanishida SSL. Odatda kerak emas — server o'zi aniqlaydi. Qo'lda: verify | 1 | 0
# PGSSL=
